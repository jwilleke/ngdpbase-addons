<%- include('header', { title: 'Occupancy review', currentUser }) %>

<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
    <h2 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Occupancy review</h2>
    <a href="/admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
  </div>
  <p class="text-muted">Occupancy information (ORC 5311.09) waiting for review. Nothing is changed until a submission is approved. Each one is also on <a href="/reviews">Reviews</a> and the board's Executive Hub; deciding it in any of them is the same decision.</p>

  <% if (flash === 'approved') { %>
    <div class="alert alert-success" data-testid="flash-approved">Approved. <%= reason %></div>
  <% } else if (flash === 'failed') { %>
    <div class="alert alert-danger" data-testid="flash-failed">Approved, but not carried out, so it is still waiting: <%= reason %></div>
  <% } else if (flash === 'rejected') { %>
    <div class="alert alert-info" data-testid="flash-rejected">Rejected. Nothing was applied.</div>
  <% } else if (flash === 'refused') { %>
    <div class="alert alert-danger" data-testid="flash-refused">Not done: <%= reason %></div>
  <% } %>

  <% if (submissions.length === 0) { %>
    <div class="alert alert-info">Nothing waits for review.</div>
  <% } %>

  <% submissions.forEach(function (s) { var a = s.answers; %>
    <div class="card mb-3" data-testid="submission">
      <div class="card-header">
        <strong><%= a.firstName %> <%= a.lastName %></strong>
        — <%= s.entryType %> of <%= s.unit %>
        <span class="text-muted small ms-2">received <time data-local-time="<%= s.receivedAt %>"><%= s.receivedAt %></time>, sent by <%= s.submitterName %></span>
      </div>
      <div class="card-body">
        <dl class="row mb-2 small">
          <% Object.keys(a).forEach(function (k) { if (a[k] !== '' && a[k] !== undefined) { %>
            <dt class="col-sm-3"><%= k %></dt><dd class="col-sm-9" style="white-space: pre-line"><%= a[k] %></dd>
          <% } }) %>
        </dl>
        <form method="POST" action="/addons/association/review/<%= encodeURIComponent(s.id) %>/approve" class="d-inline-flex gap-1 align-items-center me-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (s.accounts === 'several') { %>
            <span class="small text-danger">More than one account has this email: fix that first.</span>
          <% } %>
          <button type="submit" class="btn btn-sm btn-success">Approve</button>
        </form>
        <form method="POST" action="/addons/association/review/<%= encodeURIComponent(s.id) %>/reject" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
        </form>
        <p class="small text-muted mt-2 mb-0">Approving adds the <%= s.entryType %> entry<% if (s.share) { %>, with a <%= s.share %>% share (a different split is set on the unit's page afterwards),<% } %> for the account with this email and saves the details to its identity record. The site applies it, naming you as the one who approved.
          <% if (s.accounts === 'none') { %>No account has this email yet: approving makes one with no password, with a username from the name, and emails them an invitation to set it up.<% } %></p>
      </div>
    </div>
  <% }) %>
</div>

<%- include('footer') %>
