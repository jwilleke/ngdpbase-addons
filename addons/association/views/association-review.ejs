<%- include('header', { title: 'Occupancy review', currentUser }) %>

<div class="container-fluid mt-4">
  <h2 class="mb-1"><i class="fas fa-clipboard-check me-2"></i>Occupancy review</h2>
  <p class="text-muted">Occupancy information (ORC 5311.09) waiting for review. Nothing is changed until a submission is approved.</p>

  <% if (flash === 'approved') { %>
    <div class="alert alert-success" data-testid="flash-approved">Approved for <%= reason %>: the entry and the details are applied.</div>
  <% } else if (flash === 'rejected') { %>
    <div class="alert alert-info" data-testid="flash-rejected">Rejected. Nothing was applied.</div>
  <% } else if (flash === 'refused') { %>
    <div class="alert alert-danger" data-testid="flash-refused">Not done: <%= reason %></div>
  <% } %>

  <% if (submissions.length === 0) { %>
    <div class="alert alert-info">Nothing waits for review.</div>
  <% } %>

  <% submissions.forEach(function (s) { var a = s.answers; %>
    <div class="card mb-3" data-testid="submission">
      <div class="card-header">
        <strong><%= a.firstName %> <%= a.lastName %></strong>
        — <%= s.entryType %> of <%= s.unit %>
        <span class="text-muted small ms-2">received <time data-local-time="<%= s.receivedAt %>"><%= s.receivedAt %></time>, sent by <%= s.submittedBy %></span>
      </div>
      <div class="card-body">
        <dl class="row mb-2 small">
          <% Object.keys(a).forEach(function (k) { if (a[k] !== '' && a[k] !== undefined) { %>
            <dt class="col-sm-3"><%= k %></dt><dd class="col-sm-9" style="white-space: pre-line"><%= a[k] %></dd>
          <% } }) %>
        </dl>
        <form method="POST" action="/addons/association/review/<%= encodeURIComponent(s.id) %>/approve" class="d-inline-flex gap-1 align-items-center me-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (s.accounts === 'none') { %>
            <label class="small" for="user-<%= s.id %>">New username</label>
            <input type="text" id="user-<%= s.id %>" name="newUsername" class="form-control form-control-sm" style="width: 10rem" required
              value="<%= String((a.firstName || '') + '.' + (a.lastName || '')).toLowerCase().replace(/[^a-z0-9._-]/g, '') %>">
          <% } else if (s.accounts === 'several') { %>
            <span class="small text-danger">More than one account has this email: fix that first.</span>
          <% } %>
          <% if (s.entryType === 'owner') { %>
            <label class="small" for="share-<%= s.id %>">Share %</label>
            <input type="number" id="share-<%= s.id %>" name="share" class="form-control form-control-sm" style="width: 6rem" min="0.01" max="100" step="any" value="100" required>
          <% } %>
          <button type="submit" class="btn btn-sm btn-success">Approve</button>
        </form>
        <form method="POST" action="/addons/association/review/<%= encodeURIComponent(s.id) %>/reject" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
        </form>
        <p class="small text-muted mt-2 mb-0">Approving adds the <%= s.entryType %> entry for the account with this email and writes the details to their contact record.
          <% if (s.accounts === 'none') { %>No account has this email yet: approving makes one with no password and emails them an invitation to set it up.<% } %></p>
      </div>
    </div>
  <% }) %>
</div>

<%- include('footer') %>
