<%- include('header', { title: 'Owners and occupants: ' + label, currentUser }) %>

<% var action = '/addons/accommodation/residents/' + encodeURIComponent(parcel) + '/change'; %>
<div class="container-fluid mt-4">
  <p class="mb-1"><a href="/addons/accommodation/residents"><i class="fas fa-arrow-left me-1"></i>Owners and occupants</a></p>
  <h2 class="mb-3"><i class="fas fa-house-user me-2"></i><%= label %></h2>

  <% if (flash === 'saved') { %>
    <div class="alert alert-success" data-testid="flash-saved">Saved. The owner and occupant roles follow it when the roles job has run (Admin → Scheduled Jobs).</div>
  <% } else if (flash === 'new-person') { %>
    <div class="alert alert-warning" data-testid="flash-new-person">Nobody has an account named "<%= reason %>". If this is someone new, check their details under "Someone with no account yet" below and click Add: the account and the entry are made together. Otherwise choose the person from the list.</div>
  <% } else if (flash === 'saved-new') { %>
    <div class="alert alert-success" data-testid="flash-saved-new">Saved, with a new account (no password, no invitation sent). The roles follow when the roles job has run.</div>
  <% } else if (flash === 'saved-invited') { %>
    <div class="alert alert-success" data-testid="flash-saved-invited">Saved, with a new account. An invitation to set it up was sent, if this site sends email.</div>
  <% } else if (flash === 'billing-saved') { %>
    <div class="alert alert-success" data-testid="flash-billing-saved">Billing saved.</div>
  <% } else if (flash === 'unchanged') { %>
    <div class="alert alert-info" data-testid="flash-unchanged">Nothing to change.</div>
  <% } else if (flash === 'refused') { %>
    <div class="alert alert-danger" data-testid="flash-refused">Not saved: <%= reason %></div>
  <% } %>

  <% if (shareProblems.length > 0) { %>
    <div class="alert alert-warning" data-testid="share-problems">
      <ul class="mb-0"><% shareProblems.forEach(function (p) { %><li><%= p %></li><% }) %></ul>
    </div>
  <% } %>

  <h4>County's record</h4>
  <% if (county) { %>
    <dl class="row small mb-1" data-testid="county-record">
      <dt class="col-sm-2">Owner</dt><dd class="col-sm-10"><%= county.ownerName %></dd>
      <% if (county.attention) { %><dt class="col-sm-2">Attention</dt><dd class="col-sm-10"><%= county.attention %></dd><% } %>
      <dt class="col-sm-2">Mailing address</dt>
      <dd class="col-sm-10"><%= [county.mailingAddress.streetAddress, county.mailingAddress.addressLocality, [county.mailingAddress.addressRegion, county.mailingAddress.postalCode].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></dd>
      <dt class="col-sm-2">Newest sale</dt><dd class="col-sm-10"><%= county.lastSaleDate %></dd>
    </dl>
    <p class="small text-muted mb-4">From <%= county.source %>, read <%= county.readOn %>.</p>
  <% } else { %>
    <p class="text-muted mb-4">No county record on this accommodation.</p>
  <% } %>

  <h4>Billing</h4>
  <div class="mb-4">
    <%- include('accommodation-billing-form', { action: '/addons/accommodation/residents/' + encodeURIComponent(parcel) + '/billing', billing: billing, csrfToken: csrfToken }) %>
  </div>

  <h4>Entries</h4>
  <% if (entries.length === 0) { %>
    <p class="text-muted">Nobody owns or lives in this accommodation yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Person</th><th>As</th><th>From</th><th>Through</th><th>Share</th><th>Change</th></tr></thead>
        <tbody>
          <% entries.forEach(function (e) { %>
            <tr>
              <td><%= e.name %> <span class="text-muted small">(<%= e.username %>)</span></td>
              <td><%= e.type %></td>
              <% if (e.link) { %>
                <td><%= e.link.from %></td>
                <td><%= e.link.to %></td>
                <td><%= e.type === 'owner' ? e.link.share + '%' : '' %></td>
              <% } else { %>
                <td colspan="3" class="text-danger"><%= e.problem %></td>
              <% } %>
              <td>
                <% if (e.link && e.link.to === 'current') { %>
                  <form method="POST" action="<%= action %>" class="d-flex gap-1 mb-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="op" value="end">
                    <input type="hidden" name="username" value="<%= e.username %>">
                    <input type="hidden" name="type" value="<%= e.type %>">
                    <input type="hidden" name="index" value="<%= e.index %>">
                    <input type="hidden" name="expected" value="<%= e.expected %>">
                    <input type="date" name="on" class="form-control form-control-sm" required aria-label="Last day">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">End</button>
                  </form>
                <% } %>
                <details>
                  <summary class="small">Correct or remove</summary>
                  <form method="POST" action="<%= action %>" class="row g-1 mt-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="op" value="correct">
                    <input type="hidden" name="username" value="<%= e.username %>">
                    <input type="hidden" name="type" value="<%= e.type %>">
                    <input type="hidden" name="index" value="<%= e.index %>">
                    <input type="hidden" name="expected" value="<%= e.expected %>">
                    <div class="col-auto">
                      <select name="as" class="form-select form-select-sm" aria-label="As">
                        <option value="owner"<%= e.type === 'owner' ? ' selected' : '' %>>owner</option>
                        <option value="occupant"<%= e.type === 'occupant' ? ' selected' : '' %>>occupant</option>
                      </select>
                    </div>
                    <div class="col-auto"><input type="date" name="from" class="form-control form-control-sm" value="<%= e.link ? e.link.from : '' %>" required aria-label="From"></div>
                    <div class="col-auto"><input type="text" name="to" class="form-control form-control-sm" value="<%= e.link ? e.link.to : 'current' %>" required aria-label="Through: a date YYYY-MM-DD or current"></div>
                    <div class="col-auto"><input type="number" name="share" class="form-control form-control-sm" min="0.01" max="100" step="any" value="<%= e.link && e.link.share !== undefined ? e.link.share : '' %>" placeholder="Share %" aria-label="Share, percent (owners)"></div>
                    <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Correct</button></div>
                  </form>
                  <form method="POST" action="<%= action %>" class="mt-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="op" value="remove">
                    <input type="hidden" name="username" value="<%= e.username %>">
                    <input type="hidden" name="type" value="<%= e.type %>">
                    <input type="hidden" name="index" value="<%= e.index %>">
                    <input type="hidden" name="expected" value="<%= e.expected %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove (entered by mistake)</button>
                  </form>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <h4 class="mt-4">Add an entry</h4>
  <% var d = draft || {}; %>
  <form method="POST" action="<%= action %>" data-testid="add-entry">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="op" value="add">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small" for="add-username">Person with an account</label>
        <input type="text" id="add-username" name="username" class="form-control form-control-sm" list="people" value="<%= d.username || '' %>" placeholder="Start typing a name">
        <datalist id="people">
          <% people.forEach(function (p) { %><option value="<%= p.username %>"><%= p.name %></option><% }) %>
        </datalist>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-type">As</label>
        <select id="add-type" name="type" class="form-select form-select-sm">
          <option value="owner"<%= d.type === 'occupant' ? '' : ' selected' %>>owner</option>
          <option value="occupant"<%= d.type === 'occupant' ? ' selected' : '' %>>occupant</option>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-from">From</label>
        <input type="date" id="add-from" name="from" class="form-control form-control-sm" value="<%= d.from || (county ? county.lastSaleDate : '') %>" required>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-to">Through</label>
        <input type="text" id="add-to" name="to" class="form-control form-control-sm" value="<%= d.to || 'current' %>" required>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-share">Share % (owners)</label>
        <input type="number" id="add-share" name="share" class="form-control form-control-sm" min="0.01" max="100" step="any" value="<%= d.share || '100' %>">
      </div>
    </div>
    <details class="mt-2"<%= d.newName ? ' open' : '' %>>
      <summary class="small">Someone with no account yet</summary>
      <div class="row g-2 align-items-end mt-1">
        <div class="col-md-3">
          <label class="form-label small" for="add-new-name">Name</label>
          <input type="text" id="add-new-name" name="newName" class="form-control form-control-sm" value="<%= d.newName || '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label small" for="add-new-email">Email (if known)</label>
          <input type="email" id="add-new-email" name="newEmail" class="form-control form-control-sm" value="<%= d.newEmail || '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label small" for="add-new-username">Username (optional)</label>
          <input type="text" id="add-new-username" name="newUsername" class="form-control form-control-sm" value="<%= d.newUsername || '' %>" placeholder="made from the name">
        </div>
        <div class="col-md-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="add-invite" name="invite" value="yes"<%= d.invite === 'yes' ? ' checked' : '' %>>
            <label class="form-check-label small" for="add-invite">Email them an invitation to set up the account</label>
          </div>
        </div>
      </div>
      <p class="small text-muted mb-0 mt-1">Leave "Person with an account" empty and fill these in: an account is made with no password, and the entry is added, in one save. No invitation is sent unless you tick the box and give an email.</p>
    </details>
    <button type="submit" class="btn btn-sm btn-primary mt-2">Add</button>
  </form>
  <p class="small text-muted mt-1">Through is a date YYYY-MM-DD, or <code>current</code>. From starts as the county's newest sale date. Share is ignored for an occupant. To make an occupant an owner, or back, change <em>As</em> under "Correct or remove" (an owner needs a share).</p>
</div>

<%- include('footer') %>
