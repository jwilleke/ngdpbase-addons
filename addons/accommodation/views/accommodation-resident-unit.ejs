<%- include('header', { title: 'Owners and occupants: ' + label, currentUser }) %>

<% var action = '/addons/accommodation/residents/' + encodeURIComponent(parcel) + '/change'; %>
<div class="container-fluid mt-4">
  <div class="mb-3"><%- include('accommodation-page-heading', { icon: 'fa-house-user', title: label, back: { href: '/addons/accommodation/residents', label: 'Back to Owners and occupants' } }) %></div>

  <% if (flash === 'saved') { %>
    <div class="alert alert-success" data-testid="flash-saved">Saved. The owner and occupant roles follow it when the roles job has run (Admin → Scheduled Jobs).</div>
  <% } else if (flash === 'ownership-changed') { %>
    <div class="alert alert-success" data-testid="flash-ownership-changed">Saved: the ownership changed, and the new owners are in a new ownership period (a new folio in accounting). The roles follow when the roles job has run.</div>
  <% } else if (flash === 'use-ownership') { %>
    <div class="alert alert-info" data-testid="flash-use-ownership">The ownership really changed, so record it under <strong>Ownership changed</strong> below: give every owner from that date with their share. What you typed is filled in.</div>
  <% } else if (flash === 'saved-new') { %>
    <div class="alert alert-success" data-testid="flash-saved-new">Saved, with a new account (no password, no invitation sent). The roles follow when the roles job has run.</div>
  <% } else if (flash === 'saved-invited') { %>
    <div class="alert alert-success" data-testid="flash-saved-invited">Saved, with a new account. An invitation to set it up was sent, if this site sends email.</div>
  <% } else if (flash === 'billing-saved') { %>
    <div class="alert alert-success" data-testid="flash-billing-saved">Billing saved.</div>
  <% } else if (flash === 'unchanged') { %>
    <div class="alert alert-info" data-testid="flash-unchanged">Nothing to change.</div>
  <% } else if (flash === 'refused') { %>
    <div class="alert alert-danger" data-testid="flash-refused">Not saved: <%= reason %></div>
  <% } %>

  <% if (shareProblems.length > 0) { %>
    <div class="alert alert-warning" data-testid="share-problems">
      <ul class="mb-0"><% shareProblems.forEach(function (p) { %><li><%= p %></li><% }) %></ul>
    </div>
  <% } %>

  <h4>County's record</h4>
  <% if (county) { %>
    <dl class="row small mb-1" data-testid="county-record">
      <dt class="col-sm-2">Owner</dt><dd class="col-sm-10"><%= county.ownerName %></dd>
      <% if (county.attention) { %><dt class="col-sm-2">Attention</dt><dd class="col-sm-10"><%= county.attention %></dd><% } %>
      <dt class="col-sm-2">Mailing address</dt>
      <dd class="col-sm-10"><%= [county.mailingAddress.streetAddress, county.mailingAddress.addressLocality, [county.mailingAddress.addressRegion, county.mailingAddress.postalCode].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></dd>
      <dt class="col-sm-2">Newest sale</dt><dd class="col-sm-10"><%= county.lastSaleDate %></dd>
    </dl>
    <p class="small text-muted mb-4">From <%= county.source %>, read <%= county.readOn %>.</p>
  <% } else { %>
    <p class="text-muted mb-4">No county record on this accommodation.</p>
  <% } %>

  <h4>Billing</h4>
  <div class="mb-4">
    <%- include('accommodation-billing-form', { action: '/addons/accommodation/residents/' + encodeURIComponent(parcel) + '/billing', billing: billing, csrfToken: csrfToken }) %>
  </div>

  <h4>Owners and occupants</h4>
  <% if (entries.length === 0) { %>
    <p class="text-muted">Nobody owns or lives in this accommodation yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Person</th><th>As</th><th>From</th><th>Through</th><th>Share</th><th></th></tr></thead>
        <tbody>
          <% entries.forEach(function (e, n) { %>
            <tr>
              <td><%= e.name %> <span class="text-muted small">(<%= e.username %>)</span></td>
              <td><%= e.type %></td>
              <% if (e.link) { %>
                <td><%= e.link.from %></td>
                <td><%= e.link.to %></td>
                <td><%= e.type === 'owner' ? e.link.share + '%' : '' %></td>
              <% } else { %>
                <td colspan="3" class="text-danger"><%= e.problem %></td>
              <% } %>
              <td>
                <details>
                  <summary class="small">Edit</summary>
                  <form method="POST" action="<%= action %>" class="row g-1 mt-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="username" value="<%= e.username %>">
                    <input type="hidden" name="type" value="<%= e.type %>">
                    <input type="hidden" name="index" value="<%= e.index %>">
                    <input type="hidden" name="expected" value="<%= e.expected %>">
                    <div class="col-auto">
                      <label class="form-label small mb-0" for="as-<%= n %>">As</label>
                      <select id="as-<%= n %>" name="as" class="form-select form-select-sm">
                        <option value="owner"<%= e.type === 'owner' ? ' selected' : '' %>>owner</option>
                        <option value="occupant"<%= e.type === 'occupant' ? ' selected' : '' %>>occupant</option>
                      </select>
                    </div>
                    <div class="col-auto">
                      <label class="form-label small mb-0" for="from-<%= n %>">From</label>
                      <input type="date" id="from-<%= n %>" name="from" class="form-control form-control-sm" value="<%= e.link ? e.link.from : '' %>" required>
                    </div>
                    <div class="col-auto">
                      <label class="form-label small mb-0" for="to-<%= n %>">Through</label>
                      <input type="text" id="to-<%= n %>" name="to" class="form-control form-control-sm" value="<%= e.link ? e.link.to : 'current' %>" required>
                    </div>
                    <div class="col-auto">
                      <label class="form-label small mb-0" for="share-<%= n %>">Share %</label>
                      <input type="number" id="share-<%= n %>" name="share" class="form-control form-control-sm" min="0.01" max="100" step="any" value="<%= e.link && e.link.share !== undefined ? e.link.share : '' %>">
                    </div>
                    <div class="col-12 small">
                      <span class="me-2">If this changes an owner or a share:</span>
                      <label class="me-2"><input type="radio" name="kind" value="correction"> correcting a mistake</label>
                      <label><input type="radio" name="kind" value="change"> the ownership really changed</label>
                    </div>
                    <div class="col-12 d-flex gap-2 mt-1">
                      <button type="submit" name="op" value="correct" class="btn btn-sm btn-primary">Save</button>
                      <button type="submit" name="op" value="remove" class="btn btn-sm btn-outline-danger" formnovalidate>Remove (entered by mistake)</button>
                    </div>
                  </form>
                  <p class="small text-muted mb-0 mt-1">Moved out or sold: set Through to their last day and Save. Remove only an entry that should never have been there.</p>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% var dd = draft || {}; %>
  <% var currentOwners = entries.filter(function (e) { return e.type === 'owner' && e.link && e.link.to === 'current'; }); %>
  <% var rows = dd.rows ? JSON.parse(dd.rows) : currentOwners.map(function (e) { return { owner: e.username, label: e.name, share: dd.changeUser === e.username && dd.changeShare ? dd.changeShare : String(e.link.share), email: '' }; }); %>
  <% if (!dd.rows && dd.newPerson) rows.push({ owner: dd.newPerson, share: dd.newShare || '', email: '' }); %>
  <% while (rows.length < currentOwners.length + 3) rows.push({ owner: '', share: '', email: '' }); %>
  <h4 class="mt-4">Ownership changed</h4>
  <details<%= dd.ownership === 'open' ? ' open' : '' %> data-testid="ownership-changed">
    <summary>A sale, an owner added or removed, a transfer on death, or new shares</summary>
    <form method="POST" action="/addons/accommodation/residents/<%= encodeURIComponent(parcel) %>/ownership" class="mt-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row g-2 align-items-end mb-2">
        <div class="col-auto">
          <label class="form-label small" for="own-on">Date the ownership changed</label>
          <input type="date" id="own-on" name="on" class="form-control form-control-sm" value="<%= dd.on || '' %>" required>
        </div>
      </div>
      <p class="small mb-1">Every owner from that date, with their share (they add up to 100%). Leave a share empty to drop that owner.</p>
      <% rows.forEach(function (r, i) { %>
        <div class="row g-2 mb-1">
          <div class="col-md-4"><input type="text" name="owner" class="form-control form-control-sm" list="people" value="<%= r.label || r.owner %>" placeholder="Name: pick from the list, or a new name" aria-label="Owner <%= i + 1 %>"></div>
          <div class="col-md-2"><input type="number" name="ownerShare" class="form-control form-control-sm" min="0.01" max="100" step="any" value="<%= r.share %>" placeholder="Share %" aria-label="Share of owner <%= i + 1 %>"></div>
          <div class="col-md-3"><input type="email" name="ownerEmail" class="form-control form-control-sm" value="<%= r.email %>" placeholder="Email (new people, if known)" aria-label="Email of owner <%= i + 1 %>"></div>
        </div>
      <% }) %>
      <button type="submit" class="btn btn-sm btn-primary mt-1">Save the change of ownership</button>
    </form>
    <p class="small text-muted mt-1 mb-0">The current owners' entries end the day before the date, and the owners above start on it, in a new ownership period: accounting bills them on a new folio, and the old folio keeps its own balance. Someone new gets an account (no password, no email). Correcting a mistake is not a change of ownership: use Edit on the row instead.</p>
  </details>

  <h4 class="mt-4">Add a person</h4>
  <% var d = draft || {}; %>
  <form method="POST" action="<%= action %>" data-testid="add-entry">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="op" value="add">
    <div class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small" for="add-person">Name</label>
        <input type="text" id="add-person" name="person" class="form-control form-control-sm" list="people" value="<%= d.person || '' %>" placeholder="Pick from the list, or type a new name" required>
        <datalist id="people">
          <% people.forEach(function (p) { %><option value="<%= p.name %>"><%= p.username %></option><% }) %>
        </datalist>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-type">As</label>
        <select id="add-type" name="type" class="form-select form-select-sm">
          <option value="owner"<%= d.type === 'occupant' ? '' : ' selected' %>>owner</option>
          <option value="occupant"<%= d.type === 'occupant' ? ' selected' : '' %>>occupant</option>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-from">From</label>
        <input type="date" id="add-from" name="from" class="form-control form-control-sm" value="<%= d.from || (county ? county.lastSaleDate : '') %>" required>
      </div>
      <div class="col-auto">
        <label class="form-label small" for="add-share">Share % (owners)</label>
        <input type="number" id="add-share" name="share" class="form-control form-control-sm" min="0.01" max="100" step="any" value="<%= d.share || '100' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="add-email">Email (new people, if known)</label>
        <input type="email" id="add-email" name="email" class="form-control form-control-sm" value="<%= d.email || '' %>">
      </div>
    </div>
    <input type="hidden" name="to" value="current">
    <div class="small mt-2">
      <span class="me-2">Adding an owner:</span>
      <label class="me-2"><input type="radio" name="kind" value="correction"<%= d.kind === 'correction' ? ' checked' : '' %>> correcting a mistake (they were already an owner)</label>
      <label><input type="radio" name="kind" value="change"<%= d.kind === 'change' ? ' checked' : '' %>> the ownership really changed</label>
    </div>
    <div class="form-check mt-2">
      <input class="form-check-input" type="checkbox" id="add-invite" name="invite" value="yes"<%= d.invite === 'yes' ? ' checked' : '' %>>
      <label class="form-check-label small" for="add-invite">Email a new person an invitation to set up their account</label>
    </div>
    <button type="submit" class="btn btn-sm btn-primary mt-2">Add</button>
  </form>
  <p class="small text-muted mt-1">Someone not in the list gets an account made for them (no password; no email unless you tick the box). From starts as the county's newest sale date. Joint owners: give each their share so they add up to 100%.</p>
</div>

<%- include('footer') %>
